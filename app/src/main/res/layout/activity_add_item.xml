<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌸 Add Pantry Item"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/pink_dark"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep your pantry cute and organised ♡"
            android:textSize="15sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/itemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="♡ Food name (e.g. Rice)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:backgroundTint="@color/pink_primary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/itemQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="♡ Quantity (e.g. 5)"
            android:inputType="number"
            android:padding="14dp"
            android:backgroundTint="@color/lavender_dark"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/itemCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="♡ Category (e.g. Grains)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:backgroundTint="@color/pink_primary"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/itemExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="♡ Expiry date (YYYY-MM-DD)"
            android:inputType="date"
            android:padding="14dp"
            android:backgroundTint="@color/lavender_dark"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="♡ Save Pantry Item ♡"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/pink_primary"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Little steps, lovely pantry! 🌷"
            android:textColor="@color/lavender_dark"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="22dp"/>

    </LinearLayout>
</ScrollView>
